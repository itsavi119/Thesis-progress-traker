rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isGroupOwner(groupId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() && (
        isGroupOwner(groupId) ||
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
      );
    }

    // Researcher profiles: users can manage their own profile, read other authenticated researchers
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Multi-group research studies
    match /groups/{groupId} {
      // Only members and owner can read group details
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
      );

      // Any authenticated user can create a new group where they are owner
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      // Only the group owner can update group metadata or delete the group
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Group members subcollection
      match /members/{memberId} {
        allow read: if isGroupMember(groupId);
        // Only owner can add or remove members, or user can leave
        allow write: if isGroupOwner(groupId) || (isAuthenticated() && request.auth.uid == memberId);
      }

      // Group cases subcollection
      match /cases/{caseId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId);
        allow update, delete: if isGroupMember(groupId) && (
          isGroupOwner(groupId) || resource.data.assigned_to == request.auth.uid
        );
      }

      // Group invitations subcollection
      match /invitations/{inviteId} {
        allow read: if isAuthenticated();
        allow write: if isGroupOwner(groupId);
      }
    }

    // Top-level patient cases collection (scoped by group_id)
    match /cases/{caseId} {
      allow read: if isAuthenticated() && (
        resource == null || isGroupMember(resource.data.group_id)
      );
      allow create: if isAuthenticated() && isGroupMember(request.resource.data.group_id);
      allow update, delete: if isAuthenticated() && isGroupMember(resource.data.group_id) && (
        isGroupOwner(resource.data.group_id) || resource.data.assigned_to == request.auth.uid
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
