rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isMemberOfGroup(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return isSignedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    // Schema Validation Helpers
    function isValidUserProfile(data) {
      return data.id is string && isValidId(data.id) &&
             data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 255 &&
             data.displayName is string && data.displayName.size() <= 120 &&
             (data.role == 'member' || data.role == 'admin') &&
             (data.status == 'active' || data.status == 'suspended');
    }

    function isValidGroup(data) {
      return data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.studyTitle is string && data.studyTitle.size() > 0 && data.studyTitle.size() <= 300 &&
             data.ownerId is string && isValidId(data.ownerId) &&
             data.ownerEmail is string && data.ownerEmail.size() <= 255;
    }

    function isValidGroupMember(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.email is string && data.email.size() <= 255 &&
             data.displayName is string && data.displayName.size() <= 120 &&
             (data.role == 'owner' || data.role == 'researcher');
    }

    function isValidCase(data) {
      return data.id is string && isValidId(data.id) &&
             data.groupId is string && isValidId(data.groupId) &&
             data.patientId is string && data.patientId.size() > 0 && data.patientId.size() <= 100 &&
             (data.status == 'In Progress' || data.status == 'Completed' || data.status == 'Excluded') &&
             data.assignedTo is string && isValidId(data.assignedTo);
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if false; // Strict PII protection against enumeration
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']);
      allow delete: if false;
    }

    // Research groups collection
    match /groups/{groupId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isMemberOfGroup(groupId));
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(groupId) && isValidGroup(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(groupId) && isValidGroup(incoming()) &&
                       existing().ownerId == request.auth.uid &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'studyTitle', 'studyType', 'subjectTerminology', 'targetSampleSize', 'description', 'institution', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(groupId) && existing().ownerId == request.auth.uid;

      // Group members subcollection
      match /members/{memberId} {
        allow get, list: if isGroupOwner(groupId) || isMemberOfGroup(groupId);
        allow create: if isValidId(memberId) && isValidGroupMember(incoming()) && (isGroupOwner(groupId) || (isSignedIn() && request.auth.uid == memberId));
        allow update: if isValidId(memberId) && isValidGroupMember(incoming()) && isGroupOwner(groupId);
        allow delete: if isGroupOwner(groupId) || (isSignedIn() && request.auth.uid == memberId);
      }

      // Group cases subcollection
      match /cases/{caseId} {
        allow get, list: if isMemberOfGroup(groupId);
        allow create: if isValidId(caseId) && isValidCase(incoming()) && isMemberOfGroup(groupId) && incoming().groupId == groupId;
        allow update: if isValidId(caseId) && isValidCase(incoming()) && isMemberOfGroup(groupId) &&
                         incoming().groupId == existing().groupId &&
                         incoming().patientId == existing().patientId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['initials', 'age', 'gender', 'diagnosis', 'treatment', 'status', 'notes', 'assignedTo', 'assignedToName', 'updatedAt']);
        allow delete: if isMemberOfGroup(groupId) && (existing().assignedTo == request.auth.uid || isGroupOwner(groupId));
      }
    }
  }
}
