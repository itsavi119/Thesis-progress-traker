rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated researchers to manage user profiles
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Multi-group research studies, memberships, and invitations
    match /groups/{groupId} {
      allow read, write: if request.auth != null;

      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }

      match /cases/{caseId} {
        allow read, write: if request.auth != null;
      }

      match /invitations/{inviteId} {
        allow read, write: if request.auth != null;
      }
    }

    // Patient cases collection scoped with group_id
    match /cases/{caseId} {
      allow read, write: if request.auth != null;
    }

    // Connection verification document
    match /test/{docId} {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
