# ==============================================================================
# Thesis Progress Tracker - Environment Configuration Template
# ==============================================================================

# Server Network Port (Default: 3000)
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# JWT Authentication Secret Key (Optional: Auto-generated on startup if not set)
# JWT_SECRET=your_super_secret_random_key_here

# Persistent Storage Directory (Optional: Defaults to ./data)
# DATA_DIR=/app/data

# Google OAuth 2.0 Web Client ID (Optional: For Google Sign-In button)
# Obtain from Google Cloud Console > APIs & Services > Credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Decoupled Backend API URL (Optional: Only needed if frontend and backend are hosted on different domains)
# VITE_API_URL=https://api.yourdomain.com