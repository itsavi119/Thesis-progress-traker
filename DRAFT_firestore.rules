rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin authorization: Never rely on client claims.
    // Bootstrapped admin email avishah.as118@gmail.com with verified email or admin collection lookup
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'avishah.as118@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---

    function isValidUser(data) {
      return data.id is string && isValidId(data.id) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.display_name is string && data.display_name.size() > 0 && data.display_name.size() <= 128 &&
             (!('role' in data) || data.role in ['member', 'researcher', 'admin']) &&
             (!('photo_url' in data) || (data.photo_url is string && data.photo_url.size() <= 2048));
    }

    function isValidGroup(data) {
      return data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.studyTitle is string && data.studyTitle.size() > 0 && data.studyTitle.size() <= 256 &&
             data.targetSampleSize is number && data.targetSampleSize >= 1 && data.targetSampleSize <= 1000000 &&
             data.ownerId is string && isValidId(data.ownerId) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2048)) &&
             (!('institution' in data) || (data.institution is string && data.institution.size() <= 256));
    }

    function isValidCase(data) {
      return data.id is string && isValidId(data.id) &&
             data.group_id is string && isValidId(data.group_id) &&
             data.patient_id is string && data.patient_id.size() > 0 && data.patient_id.size() <= 128 &&
             data.normalized_patient_id is string && data.normalized_patient_id.size() > 0 && data.normalized_patient_id.size() <= 128 &&
             data.assigned_to is string && isValidId(data.assigned_to) &&
             data.status in ['In Progress', 'Completed', 'Excluded'] &&
             (!('patient_name' in data) || (data.patient_name is string && data.patient_name.size() <= 128)) &&
             (!('diagnosis' in data) || (data.diagnosis is string && data.diagnosis.size() <= 1024)) &&
             (!('drug_names' in data) || (data.drug_names is string && data.drug_names.size() <= 1024)) &&
             (!('assigned_name' in data) || (data.assigned_name is string && data.assigned_name.size() <= 128)) &&
             (!('assigned_email' in data) || (data.assigned_email is string && data.assigned_email.size() <= 256));
    }

    // --- COLLECTION RULES ---

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // User profiles: users can only read/manage their own profile; admins can manage any
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) &&
                    request.resource.data.id == userId &&
                    isValidUser(request.resource.data) &&
                    (!('role' in request.resource.data) || request.resource.data.role == 'member');
      allow update: if (
        isOwner(userId) &&
        isValidUser(request.resource.data) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name', 'email', 'photo_url', 'updated_at'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Research study groups
    match /groups/{groupId} {
      allow get: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(groupId) &&
                    request.resource.data.ownerId == request.auth.uid &&
                    isValidGroup(request.resource.data);
      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid &&
         request.resource.data.ownerId == resource.data.ownerId &&
         isValidGroup(request.resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'studyTitle', 'targetSampleSize', 'description', 'institution', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );

      // Members subcollection
      match /members/{memberId} {
        allow get: if isSignedIn() && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid ||
          request.auth.uid == memberId ||
          isAdmin()
        );
        allow list: if isSignedIn() && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
      }

      // Group-scoped invitations
      match /invitations/{inviteId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Patient cases collection (Zero-Trust Patient Data Isolation)
    match /cases/{caseId} {
      allow get: if isSignedIn() && (
        resource.data.assigned_to == request.auth.uid ||
        get(/databases/$(database)/documents/groups/$(resource.data.group_id)).data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.assigned_to == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(caseId) &&
                    request.resource.data.assigned_to == request.auth.uid &&
                    isValidCase(request.resource.data);
      allow update: if isSignedIn() && (
        (resource.data.assigned_to == request.auth.uid &&
         request.resource.data.assigned_to == resource.data.assigned_to &&
         request.resource.data.group_id == resource.data.group_id &&
         isValidCase(request.resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'patient_name', 'diagnosis', 'drug_names', 'updated_at'])) ||
        (get(/databases/$(database)/documents/groups/$(resource.data.group_id)).data.ownerId == request.auth.uid &&
         request.resource.data.assigned_to == resource.data.assigned_to &&
         request.resource.data.group_id == resource.data.group_id &&
         isValidCase(request.resource.data)) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.assigned_to == request.auth.uid ||
        get(/databases/$(database)/documents/groups/$(resource.data.group_id)).data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Administrative audit logs and system settings
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /admin_settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
